import os
import sys
import signal
from pathlib import Path

gsmBaseDir, _ = os.path.split(os.path.dirname(os.path.realpath(__file__)))
sys.path.append(os.path.dirname(gsmBaseDir))

from lib import config

from lib.const import LICENSE_INFO_DAYS

class App(object):

    def __init__(self, argc, argv):
        self.argv = argv
        self.argc = argc

        self.command = None

        baseDir = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
        self.config = config.Config(os.path.dirname(baseDir))

        # Uprading to a new GSM version that expects the config file
        # at a different location
        if not os.path.exists(self.config.fileName):
            	self.config.fileName = os.path.join(self.config.baseDir, "gsm.conf")

    def init(self):
        # configuration file exits
        if os.path.isfile(self.config.fileName):
            self.config.read()
        else:
            print(f"Configuration file {self.config.fileName} not found. Please run " \
                      "'./gsm setup' to create an initial configuration")
        return True

    def handleCommand(self):
        if not self.config.licenseInfoDays:
            print("* Migrating gsm.conf: add license_info_days = 30")
            self.config.update({"license_info_days": LICENSE_INFO_DAYS}, [])

        return True

    def run(self):
        return self.init() and self.handleCommand()



def main():
    app = App(len(sys.argv), sys.argv)
    return not app.run()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("Interrupted (Ctrl+C)")
        sys.exit(signal.SIGINT)
