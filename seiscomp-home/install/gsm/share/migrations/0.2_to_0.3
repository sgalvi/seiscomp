import os
import sys
import signal
import shutil

gsmBaseDir, _ = os.path.split(os.path.dirname(os.path.realpath(__file__)))
sys.path.append(os.path.dirname(gsmBaseDir))


from lib import config

from lib.const import (
    GSM_LOG_FILE_NAME,
    GSM_LOG_DIR,
    GSM_LOG_FILE,
    CHANGELOG
    )

class App(object):

    def __init__(self, argc, argv):
        self.argv = argv
        self.argc = argc

        self.command = None

        baseDir = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
        self.config = config.Config(os.path.dirname(baseDir))
        self.config.fileName = os.path.join(os.path.dirname(baseDir), "gsm.conf")

    def init(self):
        # configuration file exits
        if os.path.isfile(self.config.fileName):
            self.config.read()
        else:
            print(f"Configuration file {self.config.fileName} not found. Please run " \
                  "'./gsm setup' to create an initial configuration")
        return True

    def removeObsoletePaths(self, baseDir):
        # from old gsm < 1.6.15
        obsoletePaths = [
            "migrations",
            CHANGELOG,
            "README",
            "requirements.txt",
            "libs",
            "venv"
        ]

        try:
            for item in obsoletePaths:
                path = os.path.join(baseDir, item)
                if os.path.exists(path):
                    if os.path.isdir(path):
                        shutil.rmtree(path)
                    else:
                        os.remove(path)
            oldLogDir = os.path.join(baseDir, "log")
            oldLogFile = os.path.join(oldLogDir, GSM_LOG_FILE_NAME)
            varDir = os.path.join(baseDir, "var")
            if os.path.exists(oldLogDir):
                if not os.path.exists(os.path.join(baseDir, GSM_LOG_DIR)):
                    if not os.path.exists(varDir):
                        os.mkdir(varDir)
                    shutil.move(oldLogDir, varDir)
                else:
                    if os.path.exists(oldLogFile):
                        shutil.move(oldLogFile, os.path.join(baseDir, GSM_LOG_FILE))

                    shutil.rmtree(oldLogDir)

        except Exception as e:
            print(f"Could not apply migration: {e}")

    def handleCommand(self):
        self.removeObsoletePaths(self.config.baseDir)

        try:
            if self.config.syncDir and not self.config.syncDir.endswith('/var/sync'):
                tmpSyncDir = self.config.syncDir.rsplit('/', 1)[0] + '/var/sync'
                self.config.update({"sync_dir": tmpSyncDir}, [])
                oldSyncDir = os.path.join(self.config.baseDir, "sync")
                newSyncDir = os.path.join(self.config.baseDir, "var/sync")
                shutil.move(oldSyncDir, newSyncDir)
                print(f"* Migrated gsm.conf: sync_dir = {newSyncDir}")
        except Exception as e:
            print(f"Could not apply migration: {e}")

        try:
            if self.config.downloadDir and not self.config.downloadDir.endswith('/var/packages'):
                tmpDownloadDir = self.config.downloadDir.rsplit('/', 1)[0] + '/var/packages'
                self.config.update({"download_dir": tmpDownloadDir}, [])
                oldDownloadDir = os.path.join(self.config.baseDir, "packages")
                newDownloadDir = os.path.join(self.config.baseDir, "var/packages")
                shutil.move(oldDownloadDir, newDownloadDir)
                print(f"* Migrated gsm.conf: download_dir = {newDownloadDir}")
        except Exception as e:
            print(f"Could not apply migration: {e}")

        try:
            etcDir = os.path.join(self.config.baseDir, "etc")
            os.mkdir(etcDir)
            shutil.move(os.path.join(self.config.baseDir,"gsm.conf"), etcDir)
            print(f'* Migrated gsm.conf to {os.path.join(etcDir,"gsm.conf")}')
        except Exception as e:
            print(f"Could not apply migration: {e}")

        return True

    def run(self):
        return self.init() and self.handleCommand()


def main():
    app = App(len(sys.argv), sys.argv)
    return not app.run()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("Interrupted (Ctrl+C)")
        sys.exit(signal.SIGINT)
